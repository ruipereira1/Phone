<?xml version="1.0" encoding="utf-8"?>
<!-- Figma: componente "Cartão familiar". Fotografia, nome e Ligar/Vídeo diretos (96 dp). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/connect_bg_cartao"
    android:elevation="4dp"
    android:orientation="vertical"
    android:paddingBottom="16dp">

    <FrameLayout
        android:id="@+id/connect_ui_tile_frame"
        android:layout_width="match_parent"
        android:layout_height="240dp"
        android:background="@drawable/connect_bg_foto_topo"
        android:clipToOutline="true">

        <ImageView
            android:id="@+id/connect_ui_tile_photo"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no"
            android:scaleType="centerCrop" />

        <TextView
            android:id="@+id/connect_ui_tile_initials"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:importantForAccessibility="no"
            android:textColor="@android:color/white"
            android:textSize="120sp"
            android:textStyle="bold"
            android:visibility="gone" />
    </FrameLayout>

    <TextView
        android:id="@+id/connect_ui_tile_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="1"
        android:paddingTop="16dp"
        android:paddingBottom="12dp"
        android:textSize="40sp"
        android:textStyle="bold" />

    <Button
        android:id="@+id/connect_ui_tile_call"
        style="@style/ConnectBotao"
        android:layout_width="match_parent"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:background="@drawable/connect_bg_ligar"
        android:drawableStart="@drawable/connect_ic_telefone"
        android:focusable="true"
        android:text="@string/connect_ui_call" />

    <Button
        android:id="@+id/connect_ui_tile_video"
        style="@style/ConnectBotao"
        android:layout_width="match_parent"
        android:layout_marginStart="16dp"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="16dp"
        android:background="@drawable/connect_bg_video"
        android:drawableStart="@drawable/connect_ic_video"
        android:focusable="true"
        android:text="@string/connect_ui_video" />
</LinearLayout>
