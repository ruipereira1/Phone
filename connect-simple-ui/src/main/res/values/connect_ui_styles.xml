<?xml version="1.0" encoding="utf-8"?>
<!-- Segue o ficheiro Figma "Fossify Connect — Interface simplificada" (tokens em connect-core). -->
<resources>
    <style name="ConnectUi" parent="@android:style/Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/connect_fundo</item>
        <item name="android:statusBarColor">@color/connect_fundo</item>
        <item name="android:navigationBarColor">@color/connect_fundo</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:textColor">@color/connect_texto</item>
        <item name="android:fontFamily">@font/connect_atkinson</item>
    </style>

    <style name="ConnectUi.Incoming" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/connect_escuro</item>
        <item name="android:statusBarColor">@color/connect_escuro</item>
        <item name="android:navigationBarColor">@color/connect_escuro</item>
        <item name="android:textColor">@android:color/white</item>
        <item name="android:fontFamily">@font/connect_atkinson</item>
    </style>

    <style name="ConnectUi.Caregiver" parent="@android:style/Theme.Material.Light.DarkActionBar">
        <item name="android:fontFamily">@font/connect_atkinson</item>
    </style>
</resources>
