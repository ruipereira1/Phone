<?xml version="1.0" encoding="utf-8"?>
<!-- Figma: "M1 · Início (telemóvel)". Uma coluna; relógio por cima da data; aviso de chamada
     perdida com o botão a toda a largura. Os IDs são os mesmos da versão de tablet. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/connect_ui_home_clock"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:contentDescription="@string/connect_ui_home_clock_description"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="24dp"
        android:paddingEnd="16dp"
        android:paddingBottom="12dp">

        <TextClock
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:format12Hour="HH:mm"
            android:format24Hour="HH:mm"
            android:textColor="@color/connect_texto"
            android:textSize="56sp"
            android:textStyle="bold" />

        <TextClock
            android:layout_width="match_parent"
            android:layout_height="32dp"
            android:format12Hour="EEEE, d 'de' MMMM"
            android:format24Hour="EEEE, d 'de' MMMM"
            android:autoSizeMaxTextSize="24sp"
            android:autoSizeMinTextSize="16sp"
            android:autoSizeTextType="uniform"
            android:maxLines="1"
            android:textColor="@color/connect_texto_suave"
            android:textSize="24sp" />
    </LinearLayout>

    <Button
        android:id="@+id/connect_ui_home_banner"
        style="@style/ConnectBotao"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="12dp"
        android:background="@drawable/connect_bg_desligar"
        android:padding="16dp"
        android:text="@string/connect_ui_home_not_default"
        android:textSize="22sp"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/connect_ui_home_missed"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="16dp"
        android:background="@drawable/connect_bg_aviso"
        android:orientation="vertical"
        android:padding="16dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:importantForAccessibility="no"
                android:src="@drawable/connect_ic_chamada_perdida" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/connect_ui_home_missed_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="26sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/connect_ui_home_missed_when"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/connect_texto_suave"
                    android:textSize="20sp" />
            </LinearLayout>
        </LinearLayout>

        <Button
            android:id="@+id/connect_ui_home_missed_call"
            style="@style/ConnectBotao"
            android:layout_width="match_parent"
            android:layout_height="80dp"
            android:layout_marginTop="14dp"
            android:minHeight="80dp"
            android:background="@drawable/connect_bg_ligar"
            android:drawableStart="@drawable/connect_ic_telefone"
            android:text="@string/connect_ui_call_back"
            android:textSize="28sp" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <GridView
            android:id="@+id/connect_ui_home_grid"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:descendantFocusability="afterDescendants"
            android:horizontalSpacing="16dp"
            android:listSelector="@android:color/transparent"
            android:numColumns="1"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="24dp"
            android:stretchMode="columnWidth"
            android:verticalSpacing="16dp" />

        <LinearLayout
            android:id="@+id/connect_ui_home_empty"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="24dp"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="@string/connect_ui_home_empty"
                android:textSize="26sp" />

            <!-- Primeira utilização: o cuidador entra na configuração sem precisar do toque longo. -->
            <Button
                android:id="@+id/connect_ui_home_setup"
                style="@style/ConnectBotao"
                android:layout_width="match_parent"
                android:layout_marginTop="24dp"
                android:background="@drawable/connect_bg_video"
                android:text="@string/connect_ui_home_setup" />
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
