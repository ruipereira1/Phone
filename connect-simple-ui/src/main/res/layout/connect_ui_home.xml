<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="16dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/connect_ui_home_title"
            android:textSize="40sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/connect_ui_home_phone"
            style="@style/ConnectUi.SmallButton"
            android:text="@string/connect_ui_home_phone" />

        <ImageButton
            android:id="@+id/connect_ui_home_settings"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_marginStart="12dp"
            android:background="@android:color/transparent"
            android:contentDescription="@string/connect_ui_home_settings"
            android:src="@android:drawable/ic_menu_preferences"
            android:tint="#FF9E9E9E" />
    </LinearLayout>

    <Button
        android:id="@+id/connect_ui_home_banner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="12dp"
        android:backgroundTint="@color/connect_ui_reject"
        android:padding="20dp"
        android:text="@string/connect_ui_home_not_default"
        android:textAllCaps="false"
        android:textColor="@android:color/white"
        android:textSize="26sp"
        android:visibility="gone" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <GridView
            android:id="@+id/connect_ui_home_grid"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:horizontalSpacing="8dp"
            android:numColumns="2"
            android:padding="8dp"
            android:stretchMode="columnWidth"
            android:verticalSpacing="8dp" />

        <TextView
            android:id="@+id/connect_ui_home_empty"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:padding="32dp"
            android:text="@string/connect_ui_home_empty"
            android:textSize="30sp"
            android:visibility="gone" />
    </FrameLayout>
</LinearLayout>
