<?xml version="1.0" encoding="utf-8"?>
<!-- Figma: componente "Cartão familiar · telemóvel". Fotografia redonda e nome lado a lado;
     Ligar e Vídeo por baixo (88 dp). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/connect_bg_cartao"
    android:elevation="3dp"
    android:orientation="vertical"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <FrameLayout
            android:id="@+id/connect_ui_tile_frame"
            android:layout_width="112dp"
            android:layout_height="112dp"
            android:background="@drawable/connect_bg_circulo_simples"
            android:clipToOutline="true">

            <ImageView
                android:id="@+id/connect_ui_tile_photo"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:importantForAccessibility="no"
                android:scaleType="centerCrop" />

            <TextView
                android:id="@+id/connect_ui_tile_initials"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:importantForAccessibility="no"
                android:textColor="@android:color/white"
                android:textSize="56sp"
                android:textStyle="bold"
                android:visibility="gone" />
        </FrameLayout>

        <TextView
            android:id="@+id/connect_ui_tile_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="2"
            android:textSize="36sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/connect_ui_tile_call"
            style="@style/ConnectBotao"
            android:layout_width="0dp"
            android:layout_height="88dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:minHeight="88dp"
            android:background="@drawable/connect_bg_ligar"
            android:drawableStart="@drawable/connect_ic_telefone"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="@string/connect_ui_call"
            android:textSize="28sp" />

        <Button
            android:id="@+id/connect_ui_tile_video"
            style="@style/ConnectBotao"
            android:layout_width="0dp"
            android:layout_height="88dp"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:minHeight="88dp"
            android:background="@drawable/connect_bg_video"
            android:drawableStart="@drawable/connect_ic_video"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="@string/connect_ui_video"
            android:textSize="28sp" />
    </LinearLayout>
</LinearLayout>
