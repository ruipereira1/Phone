<?xml version="1.0" encoding="utf-8"?>
<!-- Estilos partilhados (botões do componente "Botão" no Figma). -->
<resources>
    <style name="ConnectBotao" parent="@android:style/Widget.Material.Button.Borderless">
        <item name="android:layout_height">@dimen/connect_botao_altura</item>
        <item name="android:minHeight">@dimen/connect_botao_altura</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingStart">20dp</item>
        <item name="android:paddingEnd">20dp</item>
        <item name="android:drawablePadding">14dp</item>
        <item name="android:fontFamily">@font/connect_atkinson</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">30sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@android:color/white</item>
        <item name="android:stateListAnimator">@null</item>
    </style>
    <style name="ConnectBotao.Grande">
        <item name="android:layout_height">@dimen/connect_botao_grande_altura</item>
        <item name="android:minHeight">@dimen/connect_botao_grande_altura</item>
        <item name="android:textSize">44sp</item>
    </style>
    <style name="ConnectControlo" parent="@android:style/Widget.Material.Button.Borderless">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">120dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_margin">10dp</item>
        <item name="android:gravity">center</item>
        <item name="android:drawablePadding">6dp</item>
        <item name="android:fontFamily">@font/connect_atkinson</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">24sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@android:color/white</item>
        <item name="android:background">@drawable/connect_bg_controlo</item>
        <item name="android:stateListAnimator">@null</item>
    </style>
    <!-- Ecrãs de configuração (Figma "M5"). -->
    <style name="ConnectConfig" parent="@android:style/Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/connect_fundo</item>
        <item name="android:statusBarColor">@color/connect_fundo</item>
        <item name="android:navigationBarColor">@color/connect_fundo</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:textColor">@color/connect_texto</item>
        <item name="android:fontFamily">@font/connect_atkinson</item>
        <item name="android:colorAccent">@color/connect_ligar</item>
    </style>
    <style name="ConnectConfig.Titulo">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">34sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/connect_texto</item>
    </style>
    <style name="ConnectConfig.Seccao">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">24dp</item>
        <item name="android:layout_marginBottom">10dp</item>
        <item name="android:textSize">22sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/connect_texto</item>
    </style>
    <style name="ConnectConfig.Nota">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textColor">@color/connect_texto_suave</item>
    </style>
    <style name="ConnectConfig.Linha">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginBottom">12dp</item>
        <item name="android:minHeight">72dp</item>
        <item name="android:background">@drawable/connect_bg_linha</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">12dp</item>
    </style>
    <style name="ConnectConfig.Interruptor" parent="@android:style/Widget.Material.CompoundButton.Switch">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginBottom">12dp</item>
        <item name="android:minHeight">72dp</item>
        <item name="android:background">@drawable/connect_bg_linha</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:textSize">20sp</item>
        <item name="android:textColor">@color/connect_texto</item>
        <item name="android:fontFamily">@font/connect_atkinson</item>
        <item name="android:thumbTint">@android:color/white</item>
        <item name="android:trackTint">@color/connect_interruptor_pista</item>
        <item name="android:trackTintMode">src_over</item>
        <item name="android:switchMinWidth">64dp</item>
    </style>
</resources>
