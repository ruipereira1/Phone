<?xml version="1.0" encoding="utf-8"?>
<!-- Figma: "M4 · Videochamada (telemóvel)". Página da Apple; por baixo, três controlos de som
     numa linha e Desligar a toda a largura. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/connect_escuro"
    android:orientation="vertical">

    <TextView
        android:id="@+id/connect_facetime_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/connect_bg_controlo"
        android:fontFamily="@font/connect_atkinson"
        android:paddingStart="16dp"
        android:paddingTop="8dp"
        android:paddingEnd="16dp"
        android:paddingBottom="8dp"
        android:textColor="@android:color/white"
        android:textSize="26sp"
        android:textStyle="bold" />

    <WebView
        android:id="@+id/connect_facetime_web"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginStart="12dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="12dp"
        android:layout_weight="1" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="6dp"
        android:paddingTop="6dp"
        android:paddingEnd="6dp">

        <Button
            android:id="@+id/connect_facetime_mic"
            style="@style/ConnectControlo"
            android:layout_height="100dp"
            android:layout_margin="6dp"
            android:drawableTop="@drawable/connect_ic_microfone"
            android:textSize="18sp" />

        <Button
            android:id="@+id/connect_facetime_vol_down"
            style="@style/ConnectControlo"
            android:layout_height="100dp"
            android:layout_margin="6dp"
            android:drawableTop="@drawable/connect_ic_volume_menos"
            android:text="@string/connect_facetime_vol_down"
            android:textSize="18sp" />

        <Button
            android:id="@+id/connect_facetime_vol_up"
            style="@style/ConnectControlo"
            android:layout_height="100dp"
            android:layout_margin="6dp"
            android:drawableTop="@drawable/connect_ic_volume_mais"
            android:text="@string/connect_facetime_vol_up"
            android:textSize="18sp" />
    </LinearLayout>

    <Button
        android:id="@+id/connect_facetime_hangup"
        style="@style/ConnectBotao"
        android:layout_width="match_parent"
        android:layout_marginStart="12dp"
        android:layout_marginTop="6dp"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="24dp"
        android:background="@drawable/connect_bg_desligar"
        android:drawableStart="@drawable/connect_ic_desligar"
        android:text="@string/connect_facetime_hangup" />
</LinearLayout>
