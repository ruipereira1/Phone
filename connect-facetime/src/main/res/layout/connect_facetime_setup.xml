<?xml version="1.0" encoding="utf-8"?>
<!-- Figma: "M6 · Configurar FaceTime". Ecrã do cuidador: colar o link do familiar (guarda sozinho),
     testar, e opções. Telemóvel e tablet (margem lateral maior em ≥ 600 dp). -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/connect_config_margem"
        android:paddingTop="32dp"
        android:paddingEnd="@dimen/connect_config_margem"
        android:paddingBottom="32dp">

        <TextView
            android:id="@+id/connect_facetime_setup_title"
            style="@style/ConnectConfig.Titulo" />

        <TextView
            style="@style/ConnectConfig.Nota"
            android:layout_marginTop="6dp"
            android:text="@string/connect_facetime_setup_intro" />

        <!-- Passo 1 -->
        <TextView
            android:id="@+id/connect_facetime_setup_step1_title"
            style="@style/ConnectConfig.Seccao" />

        <TextView
            style="@style/ConnectConfig.Linha"
            android:lineSpacingExtra="4dp"
            android:text="@string/connect_facetime_setup_steps"
            android:textSize="19sp" />

        <!-- Passo 2 -->
        <TextView
            style="@style/ConnectConfig.Seccao"
            android:text="@string/connect_facetime_setup_step2" />

        <TextView
            android:id="@+id/connect_facetime_setup_state"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:paddingStart="14dp"
            android:paddingTop="6dp"
            android:paddingEnd="14dp"
            android:paddingBottom="6dp"
            android:textSize="18sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/connect_facetime_setup_paste"
            style="@style/ConnectBotao"
            android:layout_width="match_parent"
            android:background="@drawable/connect_bg_video"
            android:text="@string/connect_facetime_setup_paste"
            android:textSize="26sp" />

        <EditText
            android:id="@+id/connect_facetime_setup_link"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="@string/connect_facetime_setup_link_hint"
            android:imeOptions="actionDone"
            android:importantForAutofill="no"
            android:inputType="textUri"
            android:minHeight="56dp"
            android:textSize="16sp" />

        <Button
            android:id="@+id/connect_facetime_setup_test"
            style="@style/ConnectBotao"
            android:layout_width="match_parent"
            android:layout_marginTop="16dp"
            android:background="@drawable/connect_bg_ligar"
            android:drawableStart="@drawable/connect_ic_video"
            android:text="@string/connect_facetime_setup_test"
            android:textSize="26sp" />

        <!-- Opções -->
        <TextView
            style="@style/ConnectConfig.Seccao"
            android:text="@string/connect_facetime_setup_options" />

        <Switch
            android:id="@+id/connect_facetime_setup_notify"
            style="@style/ConnectConfig.Interruptor"
            android:text="@string/connect_facetime_setup_notify" />

        <TextView
            style="@style/ConnectConfig.Nota"
            android:text="@string/connect_facetime_setup_owner_label" />

        <EditText
            android:id="@+id/connect_facetime_setup_owner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:hint="@string/connect_facetime_setup_owner_hint"
            android:imeOptions="actionDone"
            android:importantForAutofill="no"
            android:inputType="textPersonName|textCapWords"
            android:minHeight="56dp"
            android:textSize="20sp" />

        <Switch
            android:id="@+id/connect_facetime_setup_autofill"
            style="@style/ConnectConfig.Interruptor"
            android:text="@string/connect_facetime_setup_autofill" />

        <TextView
            android:id="@+id/connect_facetime_setup_remove"
            style="@style/ConnectConfig.Linha"
            android:text="@string/connect_facetime_setup_remove"
            android:textColor="@color/connect_desligar"
            android:textSize="20sp"
            android:textStyle="bold" />

        <!-- Estado real (classificação obrigatória) -->
        <TextView
            style="@style/ConnectConfig.Seccao"
            android:text="@string/connect_facetime_setup_status_title" />

        <TextView
            android:id="@+id/connect_facetime_setup_status"
            style="@style/ConnectConfig.Nota"
            android:textIsSelectable="true"
            android:textSize="16sp" />
    </LinearLayout>
</ScrollView>
